{
    "fafnir_v1": {
        "id": "fafnir_v1",
        "name": "HOARD_PROTOCOL",
        "description": "At the end of your turn, store unused Energy as Energized. At the start of your next turn, take 1% Max HP damage per hoarded point (min 1) as the hoard is cashed in.",
        "hooks": []
    },
    "fafnir_v2": {
        "id": "fafnir_v2",
        "name": "CORRUPTED_GOLD_OS",
        "description": "At the start of Fafnir's turn, he gains 2 Strengthened for each different debuff on him, then each of those debuffs loses 1 stack.",
        "hooks": [
            {
                "id": "fafnir_v2_corrupted",
                "trigger": "onTurnStart",
                "priority": 40,
                "when": {
                    "source": "SELF",
                    "sourceDebuffCount": { "operator": "GTE", "value": 1 }
                },
                "do": [
                    {
                        "type": "STATUS",
                        "target": "SELF",
                        "status": "Strengthened",
                        "stacks": 2,
                        "scaling": "SOURCE_DEBUFF_COUNT"
                    },
                    {
                        "type": "STATUS",
                        "target": "SELF",
                        "status": "Burn",
                        "stacks": -1
                    },
                    {
                        "type": "STATUS",
                        "target": "SELF",
                        "status": "Poison",
                        "stacks": -1
                    },
                    {
                        "type": "STATUS",
                        "target": "SELF",
                        "status": "Weakened",
                        "stacks": -1
                    },
                    {
                        "type": "STATUS",
                        "target": "SELF",
                        "status": "Dazed",
                        "stacks": -1
                    },
                    {
                        "type": "LOG",
                        "text": "{owner}'s CORRUPTED_GOLD_OS turns the rot to gold!"
                    }
                ]
            }
        ]
    },
    "fenrir_v1": {
