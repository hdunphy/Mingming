    "jormungandr_v1": {
        "id": "jormungandr_v1",
        "name": "OUROBOROS_LOOP",
        "description": "Each turn, the 5th Water card you play draws 1 card.",
        "hooks": [
            {
                "id": "jorm_v1_count",
                "trigger": "onActionStart",
                "priority": 50,
                "when": {
                    "source": "SELF",
                    "programElement": "Water"
                },
                "do": [
                    {
                        "type": "COUNTER",
                        "target": "SELF",
                        "key": "jorm_water",
                        "operator": "ADD",
                        "amount": 1
                    }
                ]
            },
            {
                "id": "jorm_v1_trigger",
                "trigger": "onActionStart",
                "priority": 40,
                "when": {
                    "source": "SELF",
                    "programElement": "Water",
                    "counters": [
                        {
                            "key": "jorm_water",
                            "operator": "EQ",
                            "value": 5
                        },
                        {
                            "key": "jorm_ouroboros_used",
                            "operator": "LT",
                            "value": 1
                        }
                    ]
                },
                "do": [
                    {
                        "type": "COUNTER",
                        "target": "SELF",
                        "key": "jorm_ouroboros_used",
                        "operator": "SET",
                        "amount": 1
                    },
                    {
                        "type": "DRAW",
                        "target": "SELF",
                        "amount": 1
                    },
                    {
                        "type": "COUNTER",
                        "target": "SELF",
                        "key": "jorm_water",
                        "operator": "RESET"
                    },
                    {
                        "type": "LOG",
                        "text": "{owner}'s OUROBOROS_LOOP triggers!"
                    }
                ]
            },
            {
                "id": "jorm_v1_reset",
                "trigger": "onTurnEnd",
                "priority": 40,
                "when": {
                    "source": "SELF"
                },
                "do": [
                    {
                        "type": "COUNTER",
                        "target": "SELF",
                        "key": "jorm_water",
                        "operator": "RESET"
                    },
                    {
                        "type": "COUNTER",
                        "target": "SELF",
                        "key": "jorm_ouroboros_used",
                        "operator": "RESET"
                    }
                ]
            }
        ]
    },
