{
  "name": "mingming_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/assert-no-debug.mjs && node scripts/assert-sfx.mjs",
    "lint": "eslint .",
    "gate": "npm run lint && tsc -b && vitest run && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "balance": "vitest run --config vitest.balance.config.ts",
    "balance:deck": "vite-node src/debug/balance/runDeckReport.ts",
    "runread": "vite-node src/debug/balance/runRunRead.ts",
    "balance:scrap-curve": "vite-node src/debug/balance/runScrapCurve.ts",
    "balance:scrap-walk": "vite-node src/debug/balance/runScrapCurveWalk.ts",
    "balance:scrap-report": "vite-node src/debug/balance/runScrapCurveReport.ts",
    "decks": "vite-node src/debug/balance/runDeckBrowser.ts",
    "balance:run-gate": "vite-node src/debug/balance/runRunGate.ts",
    "balance:walk": "vite-node src/debug/balance/runRunWalker.ts",
    "desktop:build": "node scripts/desktop-build.mjs",
    "balance:snowball": "vite-node src/debug/balance/runSnowball.ts",
    "balance:77": "node scripts/ticket77-arms.mjs",
    "balance:drivers": "vite-node src/debug/balance/runDriverCanary.ts",
    "release-check": "node scripts/release-check.mjs",
    "canary:short": "vite-node src/debug/balance/runRunGate.ts -- --cells wild:biome0,elite:biome0 --iterations 60 --gate-structural",
    "playtest": "vite-node src/debug/playtest/cli.ts",
    "playtest:night": "node scripts/playtest-night.mjs",
    "overnight": "node scripts/overnight.mjs",
    "playtest:report": "vite-node src/debug/playtest/report/cli.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@types/file-saver": "^2.0.7",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
